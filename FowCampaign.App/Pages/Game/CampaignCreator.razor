@page "/campaigncreator"
@using System.Net.Http.Headers
@using System.Text.Json
@using FowCampaign.App.DTO
@using FowCampaign.App.Shared

@attribute [Authorize]
@layout HomeLayout

@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime

<PaperSheet @ref="_paper">

    <div style="display:flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <button @onclick="GoBack"
                style="background:none; border:none; cursor:pointer; font-weight:bold; font-family:'Courier New'; font-size:1.2rem; color:#8b0000;">
            &lt; ABORT SETUP
        </button>

        <h2 style="font-family: 'Black Ops One'; margin: 0; color: #333;">
            CAMPAIGN SETUP
        </h2>

        <div style="width: 150px;"></div>
    </div>

    <div class="paper-form" style="border: none; box-shadow: none; padding: 0;">
        <div style="display: flex; gap: 20px; align-items: center; justify-content: center; margin-bottom: 20px;">
            <input type="text" class="tactical-input" @bind="_model.Name" placeholder="Operation Codename"/>

            <label class="logButton" style="padding: 10px 20px;">
                @(_hasMap ? "CHANGE MAP" : "UPLOAD MAP")
                <InputFile OnChange="HandleImageUpload" style="display: none;" accept="image/*"/>
            </label>

            <button class="logButton" @onclick="SaveCampaign" disabled="@(MissingRequirements.Any())">
                CONFIRM & DEPLOY
            </button>
        </div>

        @if (MissingRequirements.Any())
        {
            <div
                style="margin-bottom: 20px; padding: 10px; background-color: #fff3cd; border: 1px solid #ffeeba; border-left: 5px solid #ffc107; color: #856404; font-family: 'Courier New'; font-size: 0.9rem;">
                <strong>DEPLOYMENT HALTED - MISSING INTEL:</strong>
                <ul style="margin: 5px 0 0 20px; padding: 0;">
                    @foreach (var req in MissingRequirements)
                    {
                        <li>@req</li>
                    }
                </ul>
            </div>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div style="color:red; text-align:center; font-weight:bold; margin-bottom: 10px;">@_errorMessage</div>
        }

        <div class="campaign-rules-editor">
            <label for="campaign-rules">CAMPAIGN RULES <span>(Markdown and HTML)</span></label>
            <textarea id="campaign-rules" class="tactical-input" @bind="_model.Rules" @bind:event="oninput" rows="8" placeholder="Write the rules for this campaign..."></textarea>
        </div>
    </div>

    @if (_hasMap)
    {
        <div class="paper-form"
             style="margin-bottom: 15px; border: 1px dashed #555; background-color: #fcf8e3; padding: 10px;">
            <h4 style="margin-top:0;">UNIT CREATOR</h4>
            <input type="text" class="tactical-input" @bind="_unitName" style="padding-bottom: 5px;"
                   placeholder="Unit Name"/>

            <div style="display:flex; gap: 20px; align-items: flex-start;">
                <label class="logButton" style="font-size: 0.7rem; padding: 5px;">
                    + NEW UNIT ICON
                    <InputFile OnChange="@HandleIconUnitUpload" style="display: none;" accept="image/*"/>
                </label>

                @foreach (var def in _unitDefinitions)
                {
                    <div @onclick="() => _selectedDefinitionId = def.Id"
                         style="cursor: pointer; padding: 5px; border: 2px solid @(_selectedDefinitionId == def.Id ? "#bd2424" : "transparent");">
                        <img src="@def.ImageBase64" style="width: 32px; height: 32px; display: block; margin: 0 auto;"/>
                        <input @bind="def.Name"
                               style="width: 80px; border: none; background: transparent; text-align: center; font-size: 0.8rem;"/>
                    </div>
                }
            </div>
        </div>
        <div class="campaign-creator-layout" style="display: flex; gap: 20px; align-items: flex-start; margin-top: 20px;">

            <div class="campaign-creator-map-column" style="flex: 2;">
                <div
                    style="background: #ddd; padding: 5px; margin-bottom: 5px; display: flex; gap: 10px; align-items: center;">
                    <button style="@(_currentTool == "PAINT" ? "background:#333; color:white;" : "")"
                            @onclick='() => _currentTool = "PAINT"'>
                        PAINT
                    </button>
                    <button style="@(_currentTool == "DEPLOY" ? "background:#333; color:white;" : "")"
                            @onclick='() => _currentTool = "DEPLOY"'>
                        DEPLOY
                    </button>

                    @if (_currentTool == "PAINT")
                    {
                        <button @onclick="UndoPaint" disabled="@(_paintHistory.Count == 0)" style="margin-left:auto; color:#8b0000;">UNDO PAINT</button>
                    }

                    @if (_currentTool == "DEPLOY")
                    {
                        <span style="font-size:0.8rem;">Select Unit Type above ↑</span>
                        <button
                            @onclick="() =>
                            {
                                if (_deployedUnits.Any())
                                {
                                    _deployedUnits.RemoveAt(_deployedUnits.Count - 1);
                                }
                            }"
                            style="margin-left:auto; color:red;">
                            UNDO
                        </button>
                    }
                </div>
                <div class="campaign-map-zoom-controls" aria-label="Map zoom controls">
                    <span class="campaign-map-zoom-label">MAP ZOOM: @_mapZoom%</span>
                    <button class="campaign-map-zoom-button" @onclick="ZoomOut" disabled="@(_mapZoom <= 50)" aria-label="Zoom out">−</button>
                    <button class="campaign-map-zoom-button" @onclick="ResetMapZoom" disabled="@(_mapZoom == 100)">100%</button>
                    <button class="campaign-map-zoom-button" @onclick="ZoomIn" disabled="@(_mapZoom >= 200)" aria-label="Zoom in">+</button>
                </div>
                <div class="campaign-map-viewport">
                    <div class="canvas-wrapper campaign-map-surface campaign-map-zoom-@_mapZoom"
                         @onclick="HandleCanvasClick"
                         @onmousedown="HandleCanvasMouseDown"
                         @onmousemove="HandleWrapperMouseMove"
                         @onmouseleave="HandleCreatorMouseLeave"
                         @onmouseup="HandleWrapperMouseUp">
                        <canvas id="mapCanvas" class="campaign-map-canvas"></canvas>
                        @if (_hoveredRegion != null)
                        {
                            <div class="region-tooltip" style="left: @(_hoveredRegion.X.ToString(System.Globalization.CultureInfo.InvariantCulture))px; top: @(_hoveredRegion.Y.ToString(System.Globalization.CultureInfo.InvariantCulture))px; ">@_hoveredRegion.Name @_hoveredRegion.Points points</div>
                        }
                        @foreach (var unit in _deployedUnits)
                        {
                            var factionColor = _model.Factions.FirstOrDefault(f => f.Name == unit.FactionName)?.Color ?? "#000";
                            var def = _unitDefinitions.FirstOrDefault(d => d.Id == unit.DefinitionId);
                            var isBeingDragged = _draggingUnitApp == unit;

                            if (def != null)
                            {
                                <div class="map-unit @(isBeingDragged ? "is-dragging" : "")"
                                     style="position: absolute;
                 left: @((unit.X / _mapRealWidth * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%;
                 top: @((unit.Y / _mapRealHeight * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%;
             transform: translate(-50%, -50%);
             border: 2px solid @factionColor;
             box-shadow: 0 0 5px @factionColor;
             pointer-events: @(isBeingDragged ? "none" : "auto");"
                                 @onmousedown="() => StartDrag(unit)"
                                 @onmousedown:stopPropagation="true"
                                 @oncontextmenu="() => DeleteUnit(unit)"
                                 @oncontextmenu:preventDefault="true">

                                    <img src="@def.ImageBase64" style="width: 100%; height: 100%; object-fit: contain;"/>
                                </div>
                            }
                        }
                </div>
                </div>
                <div style="text-align: center; margin-top: 5px;">
                    <button @onclick="ResetMap"
                            style="color: #d32f2f; background: none; border: none; font-weight: bold; cursor: pointer;">
                        [RESET MAP]
                    </button>
                </div>
            </div>

            <div class="paper-form faction-dossier-panel" style="flex: 1; min-width: 350px;">

                <div class="new-faction-row">
                    <input type="color" class="color-picker-chip" @bind="_factionColor" title="Faction Color"/>
                    <input class="input-military" @bind="_factionName" placeholder="NEW FACTION NAME..."/>

                    <button class="logButton" style="width: auto; padding: 10px; font-size: 0.9rem;"
                            @onclick="AddFaction">
                        ADD
                    </button>
                </div>

                <div style="max-height: 500px; overflow-y: auto; padding: 5px;">
                    @foreach (var faction in _model.Factions)
                    {
                        <div class="faction-card" style="border-left: 5px solid @faction.Color;">

                            <div class="faction-header-row">
                                <div style="width:25px; height:25px; background:@faction.Color;
                                border:2px solid @(_selectedFactionApp == faction ? "#000" : "#ddd");
                                box-shadow: @(_selectedFactionApp == faction ? "0 0 5px #000" : "none");
                                cursor: pointer;"
                                     @onclick="() => _selectedFactionApp = faction"
                                     title="Select to Paint">
                                </div>

                                <input @bind="faction.Name"
                                       style="border:none; background:transparent; font-weight:bold; 
                                  font-family: 'Black Ops One'; font-size: 1.1rem; width: 100%; color: #333;"/>

                                <button class="btn-card-delete"
                                        @onclick="() => RemoveFaction(faction)" title="Scrap Faction">
                                    &times;
                                </button>
                            </div>

                            <div class="faction-options-row">

                                <label>
                                    <input type="checkbox" class="hidden-checkbox"
                                           checked="@(_myFactionApp == faction)"
                                           @onchange="() => _myFactionApp = faction"/>
                                    <div class="stamp-option stamp-commander">
                                        <div class="stamp-badge"></div>
                                        <span>COMMAND</span>
                                    </div>
                                </label>

                            </div>
                        </div>
                    }
                </div>

                <div class="intel-table-container campaign-territory-control">
                    <h4 class="intel-header">TERRITORY CONTROL</h4>
                    <table class="intel-table">
                        <thead>
                        <tr>
                            <td>REGION</td>
                            <td class="campaign-owner-header">OWNER</td>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var zone in _recordedZones.OrderBy(z => z.Name))
                        {
                            <tr class="intel-row">
                                <td>
                                    <input @bind="zone.Name"
                                           @bind:after="RefreshZoneLookupNamesAsync"
                                           aria-label="Sector name"
                                           class="campaign-sector-name-input"/>
                                </td>
                                <td class="campaign-owner-cell">
                                    <span class="faction-badge campaign-faction-badge">@zone.FactionName.ToUpper()</span>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    @if (_isSectorNameModalOpen)
    {
        <div class="sector-name-modal-overlay" @onclick="CancelSectorNaming">
            <section class="sector-name-modal" @onclick:stopPropagation="true" aria-modal="true" role="dialog" aria-labelledby="sector-name-title">
                <h3 id="sector-name-title" class="sector-name-modal-title">NAME THE SECTOR</h3>
                <p class="sector-name-modal-description">A sector must have a name before it can be assigned to a faction.</p>
                <input @bind="_pendingSectorName"
                       @bind:event="oninput"
                       class="sector-name-modal-input"
                       placeholder="SECTOR NAME..."
                       aria-label="Sector name"/>
                <input type="number" min="0" step="1"
                       @bind="_pendingSectorPoints"
                       @bind:event="oninput"
                       class="sector-name-modal-input"
                       placeholder="SECTOR POINTS..."
                       aria-label="Sector points"/>
                @if (!string.IsNullOrWhiteSpace(_pendingSectorPoints) && !TryGetSectorPoints(out _))
                {
                    <div class="action-validation-message">Enter a non-negative whole number of points.</div>
                }
                <div class="sector-name-modal-actions">
                    <button class="sector-name-modal-cancel" @onclick="CancelSectorNaming">CANCEL</button>
                    <button class="sector-name-modal-confirm" @onclick="ConfirmSectorNaming" disabled="@(!CanConfirmSector)">CONFIRM &amp; PAINT</button>
                </div>
            </section>
        </div>
    }
</PaperSheet>

@code {
    private PaperSheet _paper;
    private readonly CreateCampaignAppDto _model = new();
    private FactionAppDto _selectedFactionApp;
    private FactionAppDto _myFactionApp;
    private readonly List<ZoneSeedAppDto> _recordedZones = new();
    private readonly Stack<List<ZoneSeedAppDto>> _paintHistory = new();
    private readonly List<UnitDefinitionAppDto> _unitDefinitions = new();
    private readonly List<UnitAppDto> _deployedUnits = new();
    private UnitAppDto _draggingUnitApp;
    private double _dragStartX;
    private double _dragStartY;


    private string _unitName = string.Empty;
    private string _currentTool = "PAINT";
    private string _selectedDefinitionId;
    private string _imageDataUrl;
    private bool _hasMap;
    private byte[] _fileBytes;
    private string _fileContentType;
    private string _errorMessage;
    private string _pendingSectorName = string.Empty;
    private string _factionName = string.Empty;
    private string _factionColor = "#000000";
    private string _pendingSectorPoints = string.Empty;
    private bool CanConfirmSector => !string.IsNullOrWhiteSpace(_pendingSectorName) && TryGetSectorPoints(out _);
    private bool _shouldRenderMap;
    private bool _mapInitialized;
    private bool _isSectorNameModalOpen;
    private double _pendingSectorVisualX;
    private double _pendingSectorVisualY;
    private int _mapZoom = 100;
    private int _layoutZoom = -1;
    private HoveredRegion? _hoveredRegion;

    public class MapDimensions
    {
        public double Width { get; set; }
        public double Height { get; set; }
    }

    private double _mapRealWidth = 1;
    private double _mapRealHeight = 1;


    private List<string> MissingRequirements
    {
        get
        {
            var list = new List<string>();
            if (string.IsNullOrWhiteSpace(_model.Name))
            {
                list.Add("Operation Codename is missing.");
            }
            if (string.IsNullOrWhiteSpace(_model.Rules))
            {
                list.Add("Campaign rules are required.");
            }
            if (!_hasMap)
            {
                list.Add("Tactical Map must be uploaded.");
            }
            if (_model.Factions.Count < 2)
            {
                list.Add($"At least 2 Factions required (Current: {_model.Factions.Count}).");
            }
            if (_myFactionApp == null)
            {
                list.Add("Select your Faction to COMMAND (Checkbox).");
            }
            return list;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldRenderMap)
        {
            _shouldRenderMap = false;
            var realDims = await JsRuntime.InvokeAsync<MapDimensions>("mapTools.initMap", "mapCanvas", _imageDataUrl);
            if (realDims.Width > 0 && realDims.Height > 0)
            {
                _mapInitialized = true;
                _mapRealWidth = realDims.Width;
                _mapRealHeight = realDims.Height;
                if (_recordedZones.Count > 0)
                {
                    await JsRuntime.InvokeVoidAsync("mapTools.buildZoneLookup", _recordedZones);
                }
                await ReflowDeployedUnitsAsync();
                _layoutZoom = _mapZoom;
            }
        }
        else if (_mapInitialized && _layoutZoom != _mapZoom && _draggingUnitApp == null)
        {
            await ReflowDeployedUnitsAsync();
            _layoutZoom = _mapZoom;
            StateHasChanged();
        }
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _fileContentType = file.ContentType;
        long maxFileSize = 1024 * 1024 * 20;

        try
        {
            _fileBytes = new byte[file.Size];
            await file.OpenReadStream(maxFileSize).ReadAsync(_fileBytes);

            var base64 = Convert.ToBase64String(_fileBytes);
            _imageDataUrl = $"data:{_fileContentType};base64,{base64}";

            _hasMap = true;
            _shouldRenderMap = true;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Upload Error: {ex.Message}";
            Console.WriteLine(ex);
        }

        _shouldRenderMap = true;
    }

    private void HandleCanvasClick(MouseEventArgs e)
    {
        if (_selectedFactionApp == null)
        {
            return;
        }

        if (_currentTool == "PAINT")
        {
            _pendingSectorVisualX = e.OffsetX;
            _pendingSectorVisualY = e.OffsetY;
            _pendingSectorName = string.Empty;
            _pendingSectorPoints = string.Empty;
            _isSectorNameModalOpen = true;
        }
    }

    private async Task HandleCanvasMouseDown(MouseEventArgs e)
    {
        if (e.Button != 0 || _currentTool != "DEPLOY" || _selectedFactionApp == null ||
            string.IsNullOrWhiteSpace(_selectedDefinitionId))
        {
            return;
        }
        var coordinates = await JsRuntime.InvokeAsync<PaintCoord>("mapTools.getCanvasCoordinates", e.OffsetX, e.OffsetY);
        var zoneName = await JsRuntime.InvokeAsync<string>("mapTools.getZoneNameAt", coordinates.X, coordinates.Y);
        if (string.IsNullOrWhiteSpace(zoneName))
        {
            return;
        }

        var snapped = await JsRuntime.InvokeAsync<PaintCoord?>("mapTools.snapUnitToZone",
            zoneName, coordinates.X, coordinates.Y, _deployedUnits, (string?)null, 1);
        if (snapped == null)
        {
            return;
        }
        _deployedUnits.Add(new UnitAppDto
        {
            DefinitionId = _selectedDefinitionId,
            FactionName = _selectedFactionApp.Name,
            X = snapped.X,
            Y = snapped.Y,
            CurrentZoneName = zoneName
        });
    }

    private async Task ConfirmSectorNaming()
    {
        if (_selectedFactionApp == null || string.IsNullOrWhiteSpace(_pendingSectorName) || !TryGetSectorPoints(out var points))
        {
            return;
        }

        var realCoords = await JsRuntime.InvokeAsync<PaintCoord>(
            "mapTools.floodFill",
            _pendingSectorVisualX,
            _pendingSectorVisualY,
            _selectedFactionApp.Color
        );

        if (realCoords != null)
        {
            _paintHistory.Push(_recordedZones.Select(CloneZone).ToList());
            var nearbyExistingZone = _recordedZones
                .FirstOrDefault(z => Math.Sqrt(Math.Pow(z.X - realCoords.X, 2) + Math.Pow(z.Y - realCoords.Y, 2)) < 5);

            if (nearbyExistingZone != null)
            {
                nearbyExistingZone.FactionName = _selectedFactionApp.Name;
                nearbyExistingZone.X = realCoords.X;
                nearbyExistingZone.Y = realCoords.Y;
                nearbyExistingZone.Name = _pendingSectorName.Trim();
                nearbyExistingZone.Points = points;
            }
            else
            {
                _recordedZones.Add(new ZoneSeedAppDto
                {
                    X = realCoords.X,
                    Y = realCoords.Y,
                    FactionName = _selectedFactionApp.Name,
                    Name = _pendingSectorName.Trim(),
                    Points = points
                });
            }
            await JsRuntime.InvokeVoidAsync("mapTools.buildZoneLookup", _recordedZones);
            await ReflowDeployedUnitsAsync();
        }

        CancelSectorNaming();
    }

    private bool TryGetSectorPoints(out int points) =>
        int.TryParse(_pendingSectorPoints, out points) && points >= 0;

    private void CancelSectorNaming()
    {
        _pendingSectorName = string.Empty;
        _pendingSectorPoints = string.Empty;
        _isSectorNameModalOpen = false;
    }

    private async Task ResetMap()
    {
        await JsRuntime.InvokeVoidAsync("mapTools.resetMap");
        _recordedZones.Clear();
        _paintHistory.Clear();
        _hoveredRegion = null;
        await JsRuntime.InvokeVoidAsync("mapTools.buildZoneLookup", _recordedZones);
        await ReflowDeployedUnitsAsync();
    }

    private async Task UndoPaint()
    {
        if (_paintHistory.Count == 0)
        {
            return;
        }
        var previousZones = _paintHistory.Pop();
        _recordedZones.Clear();
        _recordedZones.AddRange(previousZones);
        await RedrawPaintedZonesAsync();
    }

    private async Task RemoveFaction(FactionAppDto faction)
    {
        _model.Factions.Remove(faction);
        _deployedUnits.RemoveAll(unit => unit.FactionName == faction.Name);
        _recordedZones.RemoveAll(zone => zone.FactionName == faction.Name);
        _paintHistory.Clear();
        if (_selectedFactionApp == faction)
        {
            _selectedFactionApp = _model.Factions.FirstOrDefault();
        }
        if (_myFactionApp == faction)
        {
            _myFactionApp = null;
        }
        await RedrawPaintedZonesAsync();
    }

    private async Task RedrawPaintedZonesAsync()
    {
        await JsRuntime.InvokeVoidAsync("mapTools.resetMap");
        foreach (var zone in _recordedZones)
        {
            var color = _model.Factions.FirstOrDefault(faction => faction.Name == zone.FactionName)?.Color;
            if (color != null)
            {
                await JsRuntime.InvokeVoidAsync("mapTools.floodFillRaw", zone.X, zone.Y, color);
            }
        }
        await JsRuntime.InvokeVoidAsync("mapTools.buildZoneLookup", _recordedZones);
        await ReflowDeployedUnitsAsync();
    }

    private async Task ReflowDeployedUnitsAsync()
    {
        if (!_mapInitialized || _draggingUnitApp != null || _deployedUnits.Count == 0)
        {
            return;
        }
        var positions = await JsRuntime.InvokeAsync<List<UnitPositionMapping>>("mapTools.layoutUnitsInZones", _deployedUnits);
        var unitsById = _deployedUnits.ToDictionary(unit => unit.Id);
        foreach (var position in positions)
        {
            if (!unitsById.TryGetValue(position.UnitId, out var unit))
            {
                continue;
            }
            unit.X = position.X;
            unit.Y = position.Y;
        }
    }

    public class UnitPositionMapping
    {
        public string UnitId { get; set; } = string.Empty;
        public double X { get; set; }
        public double Y { get; set; }
    }

    private Task RefreshZoneLookupNamesAsync() =>
        JsRuntime.InvokeVoidAsync("mapTools.buildZoneLookup", _recordedZones).AsTask();

    private static ZoneSeedAppDto CloneZone(ZoneSeedAppDto zone) => new()
    {
        X = zone.X,
        Y = zone.Y,
        FactionName = zone.FactionName,
        Name = zone.Name,
        Points = zone.Points,
    };

    private void ZoomIn()
    {
        _mapZoom = Math.Min(200, _mapZoom + 25);
    }

    private void ZoomOut()
    {
        _mapZoom = Math.Max(50, _mapZoom - 25);
    }

    private void ResetMapZoom()
    {
        _mapZoom = 100;
    }

    private async Task SaveCampaign()
    {
        if (MissingRequirements.Any())
        {
            return;
        }

        foreach (var unit in _deployedUnits)
        {
            unit.CurrentZoneName = await JsRuntime.InvokeAsync<string>("mapTools.getZoneNameAt", unit.X, unit.Y);
            if (!string.IsNullOrWhiteSpace(unit.CurrentZoneName))
            {
                continue;
            }
            _errorMessage = "Every army must be inside a painted sector before deployment.";
            return;
        }

        var zoneCoordinates = _recordedZones.Select(z => new { name = z.Name, x = z.X, y = z.Y }).ToList();
        var adjacencyGraph = await JsRuntime.InvokeAsync<Dictionary<string, List<string>>>("mapTools.calculateAdjacency", zoneCoordinates, 15);

        var gameState = new GameStateAppDto
        {
            Factions = _model.Factions,
            Zones = _recordedZones,
            Units = _deployedUnits,
            UnitDefinitions = _unitDefinitions,
            Rules = _model.Rules,
            TurnNumber = 1,
            AdjacencyGraph = adjacencyGraph
        };

        var jsonString = JsonSerializer.Serialize(gameState, new JsonSerializerOptions {PropertyNamingPolicy = JsonNamingPolicy.CamelCase});

        using var content = new MultipartFormDataContent();
        content.Add(new StringContent(_model.Name), "Name");
        content.Add(new StringContent(jsonString), "GameStateJson");
        content.Add(new StringContent(_myFactionApp.Name), "CreatorFactionName");

        var imgContent = new ByteArrayContent(_fileBytes); 
        imgContent.Headers.ContentType = new MediaTypeHeaderValue(_fileContentType);
        content.Add(imgContent, "MapImage", "map.png");

        var request = new HttpRequestMessage(HttpMethod.Post, "api/Campaign/create") { Content = content };
        request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);
        var response = await Http.SendAsync(request);

        if (response.IsSuccessStatusCode) {
            await _paper.TossAndNavigate("/home");
        } else {
            _errorMessage = "Deployment Failed. Check server logs.";
        }
    }
    private async Task HandleIconUnitUpload(InputFileChangeEventArgs e)
    {
        if (string.IsNullOrEmpty(_unitName))
        {
            return;
        }

        var file = e.File;
        var resized = await file.RequestImageFileAsync("image/png", 64, 64);
        var buffer = new byte[resized.Size];
        await resized.OpenReadStream().ReadAsync(buffer);

        var base64 = Convert.ToBase64String(buffer);

        var newDef = new UnitDefinitionAppDto
        {
            Name = _unitName,
            ImageBase64 = $"data:image/png;base64,{base64}"
        };

        _unitDefinitions.Add(newDef);
        _selectedDefinitionId = newDef.Id;
        _unitName = string.Empty;
    }

    private void StartDrag(UnitAppDto unitApp)
    {
        if (_currentTool == "DEPLOY")
        {
            _draggingUnitApp = unitApp;
            _dragStartX = unitApp.X;
            _dragStartY = unitApp.Y;
        }
    }

    private async Task HandleWrapperMouseMove(MouseEventArgs e)
    {
        if (_draggingUnitApp != null)
        {
            _hoveredRegion = null;
            var coordinates = await JsRuntime.InvokeAsync<PaintCoord>("mapTools.getCanvasCoordinates", e.OffsetX, e.OffsetY);
            _draggingUnitApp.X = coordinates.X;
            _draggingUnitApp.Y = coordinates.Y;
            return;
        }

        _hoveredRegion = await JsRuntime.InvokeAsync<HoveredRegion?>("mapTools.getHoveredZone", e.ClientX, e.ClientY);
    }

    private async Task HandleWrapperMouseUp(MouseEventArgs e)
    {
        if (_draggingUnitApp == null)
        {
            return;
        }
        var unit = _draggingUnitApp;
        _draggingUnitApp = null;
        var zoneName = await JsRuntime.InvokeAsync<string>("mapTools.getZoneNameAt", unit.X, unit.Y);
        if (string.IsNullOrWhiteSpace(zoneName))
        {
            unit.X = _dragStartX;
            unit.Y = _dragStartY;
            return;
        }

        var snapped = await JsRuntime.InvokeAsync<PaintCoord?>("mapTools.snapUnitToZone",
            zoneName, unit.X, unit.Y, _deployedUnits, unit.Id, unit.Scale);
        if (snapped == null)
        {
            unit.X = _dragStartX;
            unit.Y = _dragStartY;
            return;
        }
        unit.X = snapped.X;
        unit.Y = snapped.Y;
        unit.CurrentZoneName = zoneName;
    }

    private void HandleCreatorMouseLeave()
    {
        _hoveredRegion = null;
        if (_draggingUnitApp == null)
        {
            return;
        }
        _draggingUnitApp.X = _dragStartX;
        _draggingUnitApp.Y = _dragStartY;
        _draggingUnitApp = null;
    }

    private void DeleteUnit(UnitAppDto unitApp)
    {
        if (_currentTool == "DEPLOY")
        {
            _deployedUnits.Remove(unitApp);
        }
    }

    private async void GoBack()
    {
        await _paper.TossAndNavigate("/home");
    }

    public class PaintCoord
    {
        public double X { get; set; }
        public double Y { get; set; }
    }

    public class HoveredRegion
    {
        public string Name { get; set; } = string.Empty;
        public int Points { get; set; }
        public double X { get; set; }
        public double Y { get; set; }
    }

    private async Task AddFaction()
    {
        if (_factionName == string.Empty)
        {
            return;
        }

        var exists = _model.Factions.Any(t => t.Name == _factionName);
        if (exists)
        {
            return;
        }

        var newFaction = new FactionAppDto
        {
            Name = _factionName,
            Color = _factionColor
        };

        _model.Factions.Add(newFaction);

        _factionName = string.Empty;
        _factionColor = "#000000";

        if (_model.Factions.Count == 1)
        {
            _selectedFactionApp = newFaction;
        }

        StateHasChanged();
    }

}
