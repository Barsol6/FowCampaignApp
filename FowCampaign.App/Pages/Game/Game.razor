@page "/game/{Id:int}"
@using System.Globalization
@using System.Text.Json
@using ClosedXML.Excel
@using FowCampaign.App.DTO
@using FowCampaign.App.Handlers
@using FowCampaign.App.Shared
@using Microsoft.AspNetCore.SignalR.Client

@attribute [Authorize]
@layout HomeLayout

@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration
@implements IAsyncDisposable

<PaperSheet @ref="_paper">

    @if (_isLoading)
    {
        <div style="text-align:center; padding-top: 100px; font-family: 'Courier New';">
            <h3>DECRYPTING BATTLE PLANS...</h3>
            <p>Loading Campaign #@Id</p>
        </div>
    }
    else if (_loadError)
    {
        <div style="color:red; text-align:center; padding-top: 50px;">
            <h3>MISSION ABORTED</h3>
            <p>Could not load campaign data. Server may be offline.</p>
            <button class="btn-leave" style="width:auto; padding: 10px 20px;"
                    @onclick='() => NavigationManager.NavigateTo("/home")'>RETURN TO BASE
            </button>
        </div>
    }
    else
    {
        @if (_stateApp != null)
        {
            <div class="turn-banner" style="background-color: #333; color: white;">
                TURN @(_stateApp.TurnNumber): @(_stateApp.Phase.ToString().ToUpper())
            </div>
        }

        <div class="game-container">

            <div class="map-panel">
                <div class="map-sticky-header">
                    <span>OP: @_gameDataApp.Name</span>
                    <span>Playing As: <span style="color:yellow;">@_gameDataApp.MyFactionName</span></span>
                </div>

                <div class="game-map-zoom-controls" aria-label="Map zoom controls">
                    <span class="game-map-zoom-label">MAP ZOOM: @_gameMapZoom%</span>
                    <button class="game-map-zoom-button" @onclick="ZoomGameMapOut" disabled="@(_gameMapZoom <= 50)">−</button>
                    <button class="game-map-zoom-button" @onclick="ResetGameMapZoom">100%</button>
                    <button class="game-map-zoom-button" @onclick="ZoomGameMapIn" disabled="@(_gameMapZoom >= 200)">+</button>
                </div>

                <div class="game-map-viewport">
                    <div class="canvas-container game-map-surface game-map-zoom-@_gameMapZoom"
                         @onmousemove="HandleWrapperMouseMove"
                         @onmouseup="HandleWrapperMouseUp">

                        <canvas id="gameCanvas" class="game-canvas game-map-canvas"></canvas>

                        @if (_isProcessingMap)
                        {
                            <div class="map-overlay-blocker">
                                <div class="processing-panel">
                                    <div class="processing-text">UPDATING TACTICAL MAP...</div>
                                    <div class="progress-track">
                                        <div class="progress-bar-moving"></div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (_stateApp?.Units != null)
                        {
                            @foreach (var unit in _stateApp.Units)
                            {
                                var def = _stateApp.UnitDefinitions.FirstOrDefault(d => d.Id == unit.DefinitionId);
                                var isMyUnit = unit.FactionName == _gameDataApp.MyFactionName;

                                var canDrag = isMyUnit && (_stateApp.Phase == TurnPhase.Moving || _stateApp.Phase == TurnPhase.PostCombatMoving);

                                var dragClass = canDrag ? "unit-draggable" : "unit-locked";
                                var pointerClass = _draggingUnitApp != null ? "pointer-events-none" : "";
                                var leftPercent = unit.X / _mapRealWidth * 100.0;
                                var topPercent = unit.Y / _mapRealHeight * 100.0;
                                var factionColor = GetFactionColor(unit.FactionName);

                                var currentScale = unit.Scale > 0 ? unit.Scale : 1.0;
                                var positionStyle = $"left: {leftPercent.ToString("F2", CultureInfo.InvariantCulture)}%; top: {topPercent.ToString("F2", CultureInfo.InvariantCulture)}%; transform: translate(-50%, -50%) scale({currentScale.ToString(CultureInfo.InvariantCulture)}); border: 2px solid {factionColor}; box-shadow: 0 0 5px {factionColor};";                            {
                                <div class="map-unit @dragClass @pointerClass"
                                     style="@positionStyle"
                                     @onmousedown="() => StartDrag(unit)"
                                     @onmousedown:stopPropagation="true">
                                    <img src="@def.ImageBase64" style="width:100%; height:100%; object-fit:contain;"
                                         title="@def.Name"/>
                                </div>
                            }
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="intel-sidebar">
                <div class="sidebar-section">
                    <h4 class="section-header">COMMAND</h4>

                    <button class="btn-full btn-open-roster" @onclick="() => _showRosterModal = true">OPEN UNIT ROSTER</button>
                    <button class="btn-full btn-archive" @onclick="() => _showResultsModal = true">BATTLE LOGS</button>

                    @if (_selectedUnitForScale != null)
                    {
                        var def = _stateApp?.UnitDefinitions.FirstOrDefault(d => d.Id == _selectedUnitForScale.DefinitionId);
                        <div class="mt-15 mb-10" style="padding: 10px; background: #222; border: 1px solid #444;">
                            <label style="color: #ecf0f1; font-family: 'Courier New'; font-size: 0.9rem;">
                                SCALE: @(def?.Name ?? "UNIT") [@(_selectedUnitForScale.Scale > 0 ? _selectedUnitForScale.Scale.ToString("0.0") : "1.0")]
                            </label>
                            <input type="range" min="0.3" max="2.5" step="0.1" value="@(_selectedUnitForScale.Scale > 0 ? _selectedUnitForScale.Scale : 1.0)"
                                   @oninput='e => { _selectedUnitForScale.Scale = double.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v) ? v : 1.0; }'
                                   style="width: 100%;"/>
                        </div>
                    }

                    @if (_stateApp.Phase == TurnPhase.Moving || _stateApp.Phase == TurnPhase.PostCombatMoving)
                    {
                        <div class="status-box status-active mb-5"><strong>STATUS:</strong> @(_stateApp.Phase == TurnPhase.Moving ? "Initial movement" : "Post-battle movement")</div>
                        @if (!IsMyFactionMovementConfirmed)
                        {
                            <div class="status-box status-waiting mb-5"><strong>DRAFT:</strong> Saved for your faction</div>
                            <button class="btn-full btn-confirm" @onclick="ConfirmManeuvers" disabled="@_isConfirmingMovement">
                                @(_isConfirmingMovement ? "CONFIRMING..." : "CONFIRM MOVES")
                            </button>
                            @if (!string.IsNullOrWhiteSpace(_movementErrorMessage))
                            {
                                <div class="status-box status-battle mt-5">@_movementErrorMessage</div>
                            }
                        }
                        else
                        {
                            <div class="status-box status-waiting"><strong>STATUS:</strong> Waiting for other players...</div>
                        }
                        <div class="faction-command-panel">
                            <div class="faction-command-panel-title">MOVEMENT CONFIRMATION</div>
                            @foreach (var faction in _stateApp.Factions)
                            {
                                var hasFactionPlayer = _gameDataApp.PlayersByFaction.TryGetValue(faction.Name, out var players) && players.Any();
                                <div class="faction-command-panel-row">
                                    <span>@faction.Name</span>
                                    <strong>@(!hasFactionPlayer ? "HOLD — NO PLAYER" : _stateApp.ConfirmedMovementFactions.Contains(faction.Name) ? "CONFIRMED" : "PLANNING")</strong>
                                </div>
                            }
                        </div>
                    }
                    else if (_stateApp.Phase == TurnPhase.Combat)
                    {
                        <div class="status-box status-battle mb-10"><strong>STATUS:</strong> Combat Phase</div>
                        @foreach (var battle in _stateApp.ActiveBattles.Where(b => !b.IsResolved))
                        {
                            <div class="status-box status-battle mb-5">
                                <strong>@battle.ZoneName</strong><br/>
                                <span>@string.Join(" vs ", battle.Factions)</span>
                                @if (battle.Factions.Contains(_gameDataApp.MyFactionName))
                                {
                                    <button class="btn-full btn-battle mt-10" @onclick="() => OpenBattle(battle)">OPEN BATTLE</button>
                                }
                            </div>
                        }
                    }
                    else if (_stateApp.Phase == TurnPhase.Coloring)
                    {
                        <div class="status-box status-active mb-10"><strong>STATUS:</strong> Resolve territory coloring</div>
                        @foreach (var battle in _stateApp.ActiveBattles.Where(b => !b.ColoringResolved))
                        {
                            <div class="status-box status-battle mb-5">
                                <strong>@battle.ZoneName</strong>
                                @if (string.Equals(battle.CommanderUsername, _gameDataApp.MyUsername, StringComparison.Ordinal))
                                {
                                    <select class="battle-color-select" @bind="_coloringFactionName">
                                        @foreach (var faction in _stateApp.Factions)
                                        {
                                            <option value="@faction.Name">@faction.Name</option>
                                        }
                                    </select>
                                    <button class="btn-full btn-confirm mt-10" @onclick="() => ColorBattle(battle, false)">COLOR SECTOR</button>
                                    <button class="btn-full btn-abort mt-5" @onclick="() => ColorBattle(battle, true)">SKIP COLORING</button>
                                }
                                else
                                {
                                    <span>Awaiting battle commander: @battle.CommanderUsername</span>
                                }
                            </div>
                        }
                    }

                    <div class="faction-command-panel">
                        <div class="faction-command-panel-title">FACTION PLAYERS</div>
                        @foreach (var faction in _stateApp.Factions)
                        {
                            <div class="faction-command-panel-row">
                                <span>@faction.Name</span>
                                <strong>@string.Join(", ", _gameDataApp.PlayersByFaction.TryGetValue(faction.Name, out var players) ? players : [])</strong>
                            </div>
                        }
                    </div>
                </div>

                @if (_showBattlePanel && _battleZone != null)
                {
                    <div class="sidebar-section battle-panel">
                        <h4 class="section-header">⚔ BATTLE — @(_battleZoneName.ToUpper())</h4>

                        @if (_activeBattleApp != null)
                        {
                            <div class="battle-configuration">
                                <label><input type="checkbox" @bind="_activeBattleApp.IsAmphibious"/> AMPHIBIOUS LANDING</label>
                                @if (_activeBattleApp.IsAmphibious)
                                {
                                    <select class="battle-color-select" @bind="_activeBattleApp.AttackerFaction">
                                        <option value="">ATTACKER...</option>
                                        @foreach (var faction in _activeBattleApp.Factions)
                                        {
                                            <option value="@faction">@faction</option>
                                        }
                                    </select>
                                    <select class="battle-color-select" @bind="_activeBattleApp.DefenderFaction">
                                        <option value="">DEFENDER...</option>
                                        @foreach (var faction in _activeBattleApp.Factions)
                                        {
                                            <option value="@faction">@faction</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <button class="btn-full btn-stance-maneuver mt-10" @onclick="() => OpenBattleForStance(_activeBattleApp)">SET MY STANCE</button>
                                }
                                @if (_activeBattleApp.IsAmphibious)
                                {
                                    <button class="btn-full btn-stance-maneuver mt-10" @onclick="ConfigureAmphibiousBattle">SAVE LANDING SIDES</button>
                                }
                            </div>
                        }

                        @foreach (var faction in _battleUnits.Select(u => u.FactionName).Distinct())
                        {
                            <div class="battle-faction-row vintage-counter-box">
                                <div class="battle-faction-label faction-stamp"
                                     style="border-color: @GetFactionColor(faction); color: @GetFactionColor(faction);">
                                    @faction.ToUpper()
                                    <br/>
                                    <span style="font-size: 0.7rem; color: #fff;">
                                        STANCE: @(_factionStances.ContainsKey(faction) ? _factionStances[faction].ToString().ToUpper() : "UNKNOWN")
                                    </span>
                                </div>

                                <div class="battle-points-row counter-grid">
                                    <div class="counter-field">
                                        <label class="battle-points-label typewriter-label">MAJOR VP</label>
                                        <div class="mechanical-slot">
                                            <div class="slot-shading"></div>
                                            <input type="number" class="hidden-interactive-input" min="0"
                                                   value="@_majorPoints[faction]"
                                                   @oninput="e => _majorPoints[faction] = int.TryParse(e.Value?.ToString(), out var v) ? v : 0"/>
                                            <div class="rolling-number" @key="_majorPoints[faction]">@_majorPoints[faction]</div>
                                        </div>
                                    </div>
                                    <div class="counter-field">
                                        <label class="battle-points-label typewriter-label">MINOR VP</label>
                                        <div class="mechanical-slot">
                                            <div class="slot-shading"></div>
                                            <input type="number" class="hidden-interactive-input" min="0"
                                                   value="@_minorPoints[faction]"
                                                   @oninput="e => _minorPoints[faction] = int.TryParse(e.Value?.ToString(), out var v) ? v : 0"/>
                                            <div class="rolling-number" @key="_minorPoints[faction]">@_minorPoints[faction]</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="battle-intel-section">
                            <label class="battle-points-label typewriter-label mb-10" style="display: block;">ENGAGED FORCES (IN THIS SECTOR)</label>

                            @if (_editingUnitApp == null)
                            {
                                <div class="intel-roster" style="display: flex; flex-direction: column; gap: 10px;">
                                    @foreach (var faction in _battleUnits.Select(u => u.FactionName).Distinct())
                                    {
                                        <div class="faction-group">
                                            <div style="color: @GetFactionColor(faction); font-weight: bold; font-family: 'Courier New'; border-bottom: 1px solid #444; margin-bottom: 5px;">
                                                == @faction.ToUpper() ==
                                            </div>
                                            @foreach (var u in _battleUnits.Where(x => x.FactionName == faction))
                                            {
                                                var def = _stateApp.UnitDefinitions.FirstOrDefault(d => d.Id == u.DefinitionId);
                                                <button class="btn-full"
                                                        style="background-color: #222; color: #ccc; text-align: left; padding: 6px; margin-bottom: 3px; font-size: 0.9rem; border: 1px solid #555;"
                                                        @onclick="() => OpenExcelEditor(u)">
                                                    📄 EDIT: @(def?.Name ?? "Unknown Unit")
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else if (_activeExcelGrid != null)
                            {
                                <div class="excel-editor-panel" style="background: #1e1e1e; padding: 10px; border: 1px solid #444; margin-top: 10px;">
                                    <div style="color: #4caf50; font-family: 'Courier New'; margin-bottom: 10px; font-weight: bold;">
                                        EDITING: @_stateApp.UnitDefinitions.FirstOrDefault(d => d.Id == _editingUnitApp.DefinitionId)?.Name
                                    </div>
                                    <div style="overflow-x: auto; margin-bottom: 10px;">
                                        <table style="width: 100%; border-collapse: collapse;">
                                            <tbody>
                                            @for (var i = 0; i < _activeExcelGrid.Count; i++)
                                            {
                                                var rowIndex = i;
                                                <tr>
                                                    @for (var j = 0; j < _activeExcelGrid[rowIndex].Count; j++)
                                                    {
                                                        var colIndex = j;
                                                        <td style="border: 1px solid #555; padding: 0;">
                                                            <input type="text" @bind="_activeExcelGrid[rowIndex][colIndex]" style="width: 100%; box-sizing: border-box; background: #333; color: #fff; border: none; font-family: 'Courier New'; padding: 6px;"/>
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                            </tbody>
                                        </table>
                                    </div>
                                    <div style="display: flex; gap: 5px; margin-bottom: 15px;">
                                        <button class="btn-full" style="padding: 5px; font-size: 0.8rem; background-color: #444;" @onclick="AddExcelRow">+ ADD ROW</button>
                                        <button class="btn-full" style="padding: 5px; font-size: 0.8rem; background-color: #444;" @onclick="AddExcelColumn">+ ADD COLUMN</button>
                                    </div>
                                    <div style="display: flex; gap: 10px;">
                                        <button class="btn-full btn-confirm" @onclick="SaveExcelData">✔ SAVE INTEL</button>
                                        <button class="btn-full btn-abort" @onclick="CloseExcelEditor">CANCEL</button>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="battle-actions mt-15">
                            <input class="scenario-name-input" @bind="_scenarioName" placeholder="SCENARIO NAME (REQUIRED)"/>
                            @if (!string.IsNullOrWhiteSpace(_actionErrorMessage))
                            {
                                <div class="action-validation-message">@_actionErrorMessage</div>
                            }
                            <button class="btn-full btn-abort" @onclick="CancelBattle">CANCEL</button>
                            <button class="btn-full btn-confirm" @onclick="ConfirmBattleResults">✔ CONFIRM BATTLE</button>
                        </div>
                    </div>
                }

                <div class="intel-table-container">
                    <h4 class="intel-header">TERRITORY CONTROL</h4>
                    <table class="intel-table">
                        <thead>
                        <tr>
                            <td>REGION</td>
                            <td style="text-align: right;">OWNER</td>
                        </tr>
                        </thead>
                        <tbody>
                        @if (_stateApp != null && _stateApp.Zones != null)
                        {
                            @foreach (var zone in _stateApp.Zones.OrderBy(z => z.Name))
                            {
                                <tr class="intel-row">
                                    <td style="font-weight: bold; color: #333;">@(string.IsNullOrWhiteSpace(zone.Name) ? "Unknown Sector" : zone.Name)</td>
                                    <td style="text-align: right;">
                                        <span class="faction-badge" style="background-color: @GetFactionColor(zone.FactionName);">@zone.FactionName.ToUpper()</span>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>

                <div class="sidebar-section">
                    <button class="btn-full btn-abort" @onclick='() => NavigationManager.NavigateTo("/home")'>LEAVE WAR ROOM</button>
                </div>
            </div>
        </div>
    }
</PaperSheet>

@if (_showRouteChoiceModal)
{
    <div class="roster-modal-overlay">
        <section class="route-choice-modal" role="dialog" aria-modal="true" aria-labelledby="route-choice-title">
            <h3 id="route-choice-title" class="stance-modal-title">CHOOSE MOVEMENT ROUTE</h3>
            <p class="route-choice-description">Choose the owned sector this unit crosses before reaching @_pendingRouteDestinationName.</p>
            <div class="route-choice-actions">
                @foreach (var route in _pendingIntermediateRoutes)
                {
                    <button class="btn-full btn-stance-maneuver" @onclick="() => ConfirmRouteChoice(route)">@route</button>
                }
            </div>
            <button class="btn-full btn-abort mt-10" @onclick="CancelRouteChoice">CANCEL</button>
        </section>
    </div>
}

@if (_showStanceModal)
{
    <div class="roster-modal-overlay">
        <div class="stance-modal-paper" style="width: 500px;">
            <h3 class="stance-modal-title">TACTICAL STANCES</h3>
            <div class="stance-zone-name">SECTOR: @_battleZoneName</div>

            @{ var myFaction = _gameDataApp?.MyFactionName ?? "UNKNOWN";
                var currentStance = _factionStances.ContainsKey(myFaction) ? _factionStances[myFaction] : BattleStance.Defend; }
            <div style="margin-bottom: 15px; text-align: left; padding: 10px; border: 1px solid #444; background: #222;">
                <strong style="color: @GetFactionColor(myFaction); font-size: 1.2rem;">@myFaction.ToUpper() - YOUR ORDERS</strong>
                <div style="display: flex; gap: 5px; margin-top: 5px;">
                    <button class="btn-stance @(currentStance == BattleStance.Assault ? "btn-stance-assault" : "")"
                            style="flex:1; opacity: @(currentStance == BattleStance.Assault ? "1" : "0.4");"
                            @onclick="() => SetStance(myFaction, BattleStance.Assault)">ASSAULT
                    </button>
                    <button class="btn-stance @(currentStance == BattleStance.Maneuver ? "btn-stance-maneuver" : "")"
                            style="flex:1; opacity: @(currentStance == BattleStance.Maneuver ? "1" : "0.4");"
                            @onclick="() => SetStance(myFaction, BattleStance.Maneuver)">MANEUVER
                    </button>
                    <button class="btn-stance @(currentStance == BattleStance.Defend ? "btn-stance-defend" : "")"
                            style="flex:1; opacity: @(currentStance == BattleStance.Defend ? "1" : "0.4");"
                            @onclick="() => SetStance(myFaction, BattleStance.Defend)">DEFEND
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_actionErrorMessage))
            {
                <div class="action-validation-message">@_actionErrorMessage</div>
            }
            <button class="btn-full btn-confirm mt-20" @onclick="SubmitMyStance">DISPATCH ORDERS</button>
            <button class="btn-full btn-abort mt-10" @onclick="() => _showStanceModal = false">CANCEL</button>
        </div>
    </div>
}

@if (_showRosterModal)
{
    <div class="roster-modal-overlay">
        <div class="roster-modal-content">
            <div class="roster-modal-header">
                <h2 class="roster-modal-title">
                    <span style="color: @GetFactionColor(_gameDataApp?.MyFactionName);">@_gameDataApp.MyFactionName.ToUpper()</span> TACTICAL ROSTER
                </h2>
                <button class="btn-close-modal" @onclick="CloseRosterModal">CLOSE [X]</button>
            </div>
            @if (_editingUnitApp == null)
            {
                <table class="roster-table">
                    <thead>
                    <tr>
                        <th>UNIT TYPE</th>
                        <th>INTEL ATTACHMENT</th>
                        <th>MAP LOCATION</th>
                        <th class="text-right">ACTION</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var u in _stateApp.Units.Where(x => x.FactionName == _gameDataApp.MyFactionName))
                    {
                        var def = _stateApp.UnitDefinitions.FirstOrDefault(d => d.Id == u.DefinitionId);
                        <tr class="roster-table-row">
                            <td>
                                @if (def != null)
                                {
                                    <img src="@def.ImageBase64" class="roster-unit-icon"/>
                                }
                                <strong>@(def?.Name ?? "Unknown Unit")</strong>
                            </td>
                            <td class="text-muted">@(string.IsNullOrEmpty(u.ExcelDatabase64) ? "[ No File ]" : string.IsNullOrEmpty(u.ExcelFileName) ? "[ Custom Edited Grid ]" : u.ExcelFileName)</td>
                            <td class="text-dim">X: @((int)u.X), Y: @((int)u.Y)</td>
                            <td class="text-right">
                                <button class="btn-edit-excel" @onclick="() => OpenExcelEditor(u)">EDIT EXCEL</button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            else if (_activeExcelGrid != null)
            {
                <div class="excel-editor-container">
                    <h3 class="excel-editor-title">EDITING: @_stateApp.UnitDefinitions.FirstOrDefault(d => d.Id == _editingUnitApp.DefinitionId)?.Name</h3>
                    @if (!string.IsNullOrWhiteSpace(_actionErrorMessage))
                    {
                        <div class="action-validation-message">@_actionErrorMessage</div>
                    }
                    <div class="excel-table-wrapper">
                        <table class="excel-grid-table">
                            <tbody>
                            @for (var i = 0; i < _activeExcelGrid.Count; i++)
                            {
                                var rowIndex = i;
                                <tr>
                                    @for (var j = 0; j < _activeExcelGrid[rowIndex].Count; j++)
                                    {
                                        var colIndex = j;
                                        <td><input type="text" class="excel-cell-input" @bind="_activeExcelGrid[rowIndex][colIndex]"/></td>
                                    }
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <div class="excel-editor-controls">
                        <button class="btn-excel-tool" @onclick="AddExcelRow">ADD ROW</button>
                        <button class="btn-excel-tool" @onclick="AddExcelColumn">ADD COLUMN</button>
                    </div>
                    <div class="excel-editor-actions">
                        <button class="btn-save-roster" @onclick="SaveExcelData">SAVE TO ROSTER</button>
                        <button class="btn-cancel-roster" @onclick="CloseExcelEditor">CANCEL</button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (_showResultsModal)
{
    <div class="roster-modal-overlay">
        <div class="roster-modal-content">
            <div class="roster-modal-header">
                <h2 class="roster-modal-title">BATTLE ARCHIVE</h2>
                <button class="btn-close-modal" @onclick="() => _showResultsModal = false">CLOSE [X]</button>
            </div>
            @if (_stateApp?.BattleResults == null || !_stateApp.BattleResults.Any())
            {
                <p class="text-muted text-center mt-20">NO BATTLE RECORDS FOUND.</p>
            }
            else
            {
                <table class="archive-table">
                    <thead>
                    <tr>
                        <th>TURN</th>
                        <th>ZONE</th>
                        <th>SCENARIO</th>
                        <th>COMMANDER</th>
                        <th>STANCES</th>
                        <th>OUTCOME (MAJOR / MINOR VP)</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var result in _stateApp.BattleResults.OrderByDescending(r => r.TurnNumber))
                    {
                        <tr class="archive-table-row">
                            <td>@result.TurnNumber</td>
                            <td>@result.ZoneName</td>
                            <td>@result.ScenarioName</td>
                            <td>@result.CommanderUsername</td>
                            <td>
                                @if (result.Stances != null)
                                {
                                    @foreach (var st in result.Stances)
                                    {
                                        <div style="font-size: 0.8rem; color: @GetFactionColor(st.Key);"><span class="stance-badge">@st.Value</span></div>
                                    }
                                }
                            </td>
                            <td>
                                @foreach (var kvp in result.MajorPoints)
                                {
                                    <div style="color: @GetFactionColor(kvp.Key);"><strong>@kvp.Key.ToUpper():</strong>
                                        Major: @kvp.Value,
                                        Minor: @(result.MinorPoints.ContainsKey(kvp.Key) ? result.MinorPoints[kvp.Key] : 0)
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private PaperSheet _paper;
    private LoadGameDataAppDto? _gameDataApp;
    private GameStateAppDto? _stateApp;
    private UnitAppDto _draggingUnitApp;
    private bool _isProcessingMap;

    private bool _battleAvailable;
    private bool _showBattlePanel;
    private bool _showStanceModal;
    private bool _showResultsModal;

    private UnitAppDto? _selectedUnitForScale;
    private Dictionary<string, BattleStance> _factionStances = new();

    private string _battleZoneName;
    private ZoneSeedAppDto? _battleZone;
    private List<UnitAppDto> _battleUnits = [];
    private double _mapRealWidth = 1;
    private double _mapRealHeight = 1;
    private double _dragScaleFactor = 1.0;
    private readonly Dictionary<string, int> _majorPoints = new();
    private readonly Dictionary<string, int> _minorPoints = new();

    private bool _isLoading = true;
    private bool _loadError;
    private bool _mapRendered;

    private UnitAppDto _editingUnitApp;
    private List<List<string>> _activeExcelGrid = new();
    private byte[] _originalExcelBytes;
    private bool _showRosterModal;

    private HubConnection? _hubConnection;
    private ActiveBattleAppDto? _activeBattleApp;
    private string _scenarioName = string.Empty;
    private string _coloringFactionName = string.Empty;
    private string _actionErrorMessage = string.Empty;
    private int _gameMapZoom = 100;
    private readonly Dictionary<string, UnitManeuver> _trialManeuvers = new();
    private double _dragStartX;
    private double _dragStartY;
    private bool _showRouteChoiceModal;
    private List<string> _pendingIntermediateRoutes = new();
    private UnitManeuver? _pendingRouteManeuver;
    private string _pendingRouteDestinationName = string.Empty;
    private bool _isConfirmingMovement;
    private string _movementErrorMessage = string.Empty;
    private bool _unitZoneSynchronizationAttempted;
    private readonly SemaphoreSlim _stateRefreshLock = new(1, 1);

    private bool IsMyFactionMovementConfirmed => _stateApp?.ConfirmedMovementFactions.Contains(_gameDataApp?.MyFactionName ?? string.Empty) == true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadGameDataAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading game data: {ex.Message}");
            _loadError = true;
            _isLoading = false;
            return;
        }

        try
        {
            await InitializeHubConnectionAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR connection unavailable: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadGameDataAsync()
    {
        var gameData = await Http.GetFromJsonAsync<LoadGameDataAppDto>($"api/Campaign/{Id}");
        if (gameData == null || string.IsNullOrWhiteSpace(gameData.GameStateJson))
            throw new InvalidOperationException("Campaign data is unavailable.");

        var state = JsonSerializer.Deserialize<GameStateAppDto>(gameData.GameStateJson, new JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true,
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        });

        if (state == null)
            throw new InvalidOperationException("Campaign state is invalid.");

        if (string.IsNullOrWhiteSpace(state.CurrentTurnFaction))
            state.CurrentTurnFaction = state.Factions.FirstOrDefault()?.Name ?? string.Empty;

        if (state.TurnNumber < 1)
            state.TurnNumber = 1;

        _gameDataApp = gameData;
        _stateApp = state;
        _trialManeuvers.Clear();
        var hasVisibleDraft = state.MovementDrafts.TryGetValue(gameData.MyFactionName, out var savedDraft);
        if (!hasVisibleDraft)
            state.PendingManeuvers.TryGetValue(gameData.MyFactionName, out savedDraft);

        if (savedDraft != null)
        {
            foreach (var maneuver in savedDraft)
            {
                if (!IsMyFactionMovementConfirmed)
                    _trialManeuvers[maneuver.UnitId] = maneuver;
            }

            foreach (var maneuver in savedDraft)
            {
                var unit = state.Units.FirstOrDefault(candidate => candidate.Id == maneuver.UnitId);
                if (unit == null) continue;
                unit.X = maneuver.TargetX;
                unit.Y = maneuver.TargetY;
            }
        }

        if (string.IsNullOrWhiteSpace(_coloringFactionName))
            _coloringFactionName = state.Factions.FirstOrDefault()?.Name ?? string.Empty;
    }

    private async Task InitializeHubConnectionAsync()
    {
        if (_hubConnection != null) return;

        var apiBaseUrl = Configuration["ApiBaseUrl"] ?? NavigationManager.BaseUri;
        var hubUrl = $"{apiBaseUrl.TrimEnd('/')}/gamehub";

        _hubConnection = new HubConnectionBuilder()
            .WithUrl(hubUrl, options =>
            {
                options.HttpMessageHandlerFactory = innerHandler => new CookieHandler
                {
                    InnerHandler = innerHandler
                };
            })
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On("GameUpdated", () => InvokeAsync(RefreshGameStateAsync));
        _hubConnection.Reconnected += async _ => await JoinCampaignHubGroupAsync();

        await _hubConnection.StartAsync();
        await JoinCampaignHubGroupAsync();
    }

    private async Task JoinCampaignHubGroupAsync()
    {
        if (_hubConnection?.State == HubConnectionState.Connected)
            await _hubConnection.SendAsync("JoinCampaignGroup", Id);
    }

    private string GetFactionColor(string factionName) => _stateApp?.Factions.FirstOrDefault(f => f.Name == factionName)?.Color ?? "#000000";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isLoading && !_loadError && !_mapRendered && _gameDataApp != null)
        {
            _mapRendered = true;
            try
            {
                var dims = await JS.InvokeAsync<MapDimensions>("mapTools.initMap", "gameCanvas", _gameDataApp.MapImageBase64);
                if (dims.Width > 0)
                {
                    _mapRealWidth = dims.Width;
                    _mapRealHeight = dims.Height;
                    await Task.Delay(50);

                    await SynchronizeUntrackedUnitZonesAsync();

                    await PaintZoneOwnershipAsync();

                    StateHasChanged();
                }

                await RecalculateBattleAvailability();
            }
            catch (Exception ex)
            {
                Console.WriteLine("Map Render Failed: " + ex.Message);
            }
        }
    }

    private async Task StartDrag(UnitAppDto unitApp)
    {
        _selectedUnitForScale = unitApp;

        if (_stateApp.Phase != TurnPhase.Moving && _stateApp.Phase != TurnPhase.PostCombatMoving) return;
        if (IsMyFactionMovementConfirmed) return;

        if (unitApp.FactionName == _gameDataApp.MyFactionName)
        {
            _draggingUnitApp = unitApp;
            _dragStartX = unitApp.X;
            _dragStartY = unitApp.Y;
            var visualDims = await JS.InvokeAsync<MapDimensions>("mapTools.getClientDimensions", "gameCanvas");
            if (visualDims.Width > 0) _dragScaleFactor = _mapRealWidth / visualDims.Width;
        }
    }

    private async Task HandleWrapperMouseMove(MouseEventArgs e)
    {
        if (_draggingUnitApp != null)
        {
            _draggingUnitApp.X = e.OffsetX * _dragScaleFactor;
            _draggingUnitApp.Y = e.OffsetY * _dragScaleFactor;
        }
    }

    private async Task HandleWrapperMouseUp(MouseEventArgs _)
    {
        if (_draggingUnitApp != null)
        {
            var draggedUnit = _draggingUnitApp;
            _draggingUnitApp = null;
            await PlanMovementAsync(draggedUnit);
        }
    }

    private async Task ConfirmManeuvers()
    {
        if (_stateApp == null || _gameDataApp == null || _isConfirmingMovement) return;

        _isConfirmingMovement = true;
        _movementErrorMessage = string.Empty;
        try
        {
            if (!await SaveCompleteDraftAsync()) return;

            var response = await Http.PostAsync($"api/Campaign/{Id}/maneuver/confirm", null);
            if (response.IsSuccessStatusCode)
            {
                await RefreshGameStateAsync();
                return;
            }

            _movementErrorMessage = await response.Content.ReadAsStringAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Unable to confirm movement: {ex.Message}");
            _movementErrorMessage = "Unable to confirm movement. Try again.";
        }
        finally
        {
            _isConfirmingMovement = false;
        }
    }

    private async Task PlanMovementAsync(UnitAppDto unit)
    {
        if (_stateApp == null || _gameDataApp == null) return;
        var originZoneName = _trialManeuvers.TryGetValue(unit.Id, out var existingPlan)
            ? existingPlan.OriginZoneName
            : await GetZoneNameAtAsync(_dragStartX, _dragStartY);
        var destinationZoneName = await GetZoneNameAtAsync(unit.X, unit.Y);
        if (string.IsNullOrWhiteSpace(originZoneName) || string.IsNullOrWhiteSpace(destinationZoneName))
        {
            RestoreDraggedUnit(unit);
            return;
        }

        var maneuver = new UnitManeuver
        {
            UnitId = unit.Id,
            TargetX = unit.X,
            TargetY = unit.Y,
            OriginZoneName = originZoneName,
            DestinationZoneName = destinationZoneName
        };

        if (string.Equals(originZoneName, destinationZoneName, StringComparison.OrdinalIgnoreCase))
        {
            _trialManeuvers[unit.Id] = maneuver;
            await SaveCompleteDraftAsync();
            return;
        }

        if (_stateApp.AdjacencyGraph.TryGetValue(originZoneName, out var directNeighbors) && directNeighbors.Contains(destinationZoneName, StringComparer.OrdinalIgnoreCase))
        {
            _trialManeuvers[unit.Id] = maneuver;
            await SaveCompleteDraftAsync();
            return;
        }

        var possibleIntermediateRoutes = _stateApp.Zones
            .Where(zone => string.Equals(zone.FactionName, _gameDataApp.MyFactionName, StringComparison.OrdinalIgnoreCase))
            .Where(zone => _stateApp.AdjacencyGraph.TryGetValue(originZoneName, out var originNeighbors) && originNeighbors.Contains(zone.Name, StringComparer.OrdinalIgnoreCase))
            .Where(zone => _stateApp.AdjacencyGraph.TryGetValue(zone.Name, out var intermediateNeighbors) && intermediateNeighbors.Contains(destinationZoneName, StringComparer.OrdinalIgnoreCase))
            .Select(zone => zone.Name)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (!possibleIntermediateRoutes.Any())
        {
            RestoreDraggedUnit(unit);
            return;
        }

        if (possibleIntermediateRoutes.Count == 1)
        {
            maneuver.IntermediateZoneName = possibleIntermediateRoutes[0];
            _trialManeuvers[unit.Id] = maneuver;
            await SaveCompleteDraftAsync();
            return;
        }

        _pendingRouteManeuver = maneuver;
        _pendingIntermediateRoutes = possibleIntermediateRoutes;
        _pendingRouteDestinationName = destinationZoneName;
        _showRouteChoiceModal = true;
    }

    private async Task ConfirmRouteChoice(string intermediateZoneName)
    {
        if (_pendingRouteManeuver == null) return;
        _pendingRouteManeuver.IntermediateZoneName = intermediateZoneName;
        _trialManeuvers[_pendingRouteManeuver.UnitId] = _pendingRouteManeuver;
        CancelRouteChoice();
        await SaveCompleteDraftAsync();
    }

    private void CancelRouteChoice()
    {
        if (_pendingRouteManeuver != null)
        {
            var unit = _stateApp?.Units.FirstOrDefault(candidate => candidate.Id == _pendingRouteManeuver.UnitId);
            if (unit != null) RestoreDraggedUnit(unit);
        }

        _pendingRouteManeuver = null;
        _pendingIntermediateRoutes.Clear();
        _pendingRouteDestinationName = string.Empty;
        _showRouteChoiceModal = false;
    }

    private void RestoreDraggedUnit(UnitAppDto unit)
    {
        if (_trialManeuvers.TryGetValue(unit.Id, out var existingPlan))
        {
            unit.X = existingPlan.TargetX;
            unit.Y = existingPlan.TargetY;
            return;
        }

        unit.X = _dragStartX;
        unit.Y = _dragStartY;
    }

    private async Task<string> GetZoneNameAtAsync(double x, double y)
    {
        if (_stateApp?.Zones == null) return string.Empty;
        var mappings = await JS.InvokeAsync<List<UnitZoneMapping>>("mapTools.assignUnitsToZones", new[]
        {
            new UnitAppDto { Id = "route-preview", X = x, Y = y }
        }, _stateApp.Zones);
        var zoneId = mappings.FirstOrDefault()?.ZoneId ?? -1;
        return zoneId >= 0 && zoneId < _stateApp.Zones.Count ? _stateApp.Zones[zoneId].Name : string.Empty;
    }

    private async Task<bool> SaveCompleteDraftAsync()
    {
        if (_stateApp == null || _gameDataApp == null || IsMyFactionMovementConfirmed) return false;

        var currentMappings = await JS.InvokeAsync<List<UnitZoneMapping>>("mapTools.assignUnitsToZones", _stateApp.Units.Where(unit => unit.FactionName == _gameDataApp.MyFactionName).ToList(), _stateApp.Zones);
        var mappingsByUnitId = currentMappings.ToDictionary(mapping => mapping.UnitId, mapping => mapping.ZoneId);
        var completeDraft = new List<UnitManeuver>();

        foreach (var unit in _stateApp.Units.Where(candidate => candidate.FactionName == _gameDataApp.MyFactionName))
        {
            if (_trialManeuvers.TryGetValue(unit.Id, out var plannedManeuver))
            {
                completeDraft.Add(plannedManeuver);
                continue;
            }

            if (!mappingsByUnitId.TryGetValue(unit.Id, out var zoneId) || zoneId < 0 || zoneId >= _stateApp.Zones.Count) continue;
            var zoneName = _stateApp.Zones[zoneId].Name;
            completeDraft.Add(new UnitManeuver
            {
                UnitId = unit.Id,
                TargetX = unit.X,
                TargetY = unit.Y,
                OriginZoneName = zoneName,
                DestinationZoneName = zoneName
            });
        }

        if (completeDraft.Count != _stateApp.Units.Count(unit => unit.FactionName == _gameDataApp.MyFactionName))
        {
            _movementErrorMessage = "Every unit must be located inside a named sector before confirming.";
            return false;
        }
        var response = await Http.PostAsJsonAsync($"api/Campaign/{Id}/maneuver/draft", completeDraft);
        if (response.IsSuccessStatusCode) return true;

        _movementErrorMessage = await response.Content.ReadAsStringAsync();
        await RefreshGameStateAsync();
        return false;
    }

    private async Task SynchronizeUntrackedUnitZonesAsync()
    {
        if (_unitZoneSynchronizationAttempted || _stateApp == null || !_stateApp.Units.Any(unit => string.IsNullOrWhiteSpace(unit.CurrentZoneName))) return;

        _unitZoneSynchronizationAttempted = true;
        var mappings = await JS.InvokeAsync<List<UnitZoneMapping>>("mapTools.assignUnitsToZones", _stateApp.Units, _stateApp.Zones);
        var zoneNamesByUnitId = mappings
            .Where(mapping => mapping.ZoneId >= 0 && mapping.ZoneId < _stateApp.Zones.Count)
            .ToDictionary(mapping => mapping.UnitId, mapping => _stateApp.Zones[mapping.ZoneId].Name);

        foreach (var unit in _stateApp.Units)
        {
            if (zoneNamesByUnitId.TryGetValue(unit.Id, out var zoneName)) unit.CurrentZoneName = zoneName;
        }

        var response = await Http.PostAsJsonAsync($"api/Campaign/{Id}/unit-zones", zoneNamesByUnitId);
        if (!response.IsSuccessStatusCode)
        {
            _movementErrorMessage = "The server could not synchronize unit positions with the map.";
            _unitZoneSynchronizationAttempted = false;
        }
    }

    private Task RecalculateBattleAvailability()
    {
        _battleAvailable = _stateApp?.ActiveBattles.Any(battle => !battle.IsResolved) == true;
        if (_activeBattleApp != null && _stateApp != null)
        {
            _activeBattleApp = _stateApp.ActiveBattles.FirstOrDefault(battle => battle.Id == _activeBattleApp.Id);
            if (_activeBattleApp == null)
            {
                _showBattlePanel = false;
                _showStanceModal = false;
            }
        }

        if (_showStanceModal && _stateApp?.PendingStances.TryGetValue(_battleZoneName, out var submittedStances) == true &&
            submittedStances.ContainsKey(_gameDataApp?.MyFactionName ?? string.Empty))
        {
            _showStanceModal = false;
            _showBattlePanel = _activeBattleApp != null;
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    private void OpenBattle(ActiveBattleAppDto battle)
    {
        _actionErrorMessage = string.Empty;
        _activeBattleApp = battle;
        _battleZoneName = battle.ZoneName;
        _battleZone = _stateApp?.Zones.FirstOrDefault(zone => zone.Name == battle.ZoneName);
        _battleUnits = _stateApp?.Units.Where(unit => battle.UnitIds.Contains(unit.Id)).ToList() ?? [];
        _scenarioName = battle.ScenarioName;
        _majorPoints.Clear();
        _minorPoints.Clear();
        _factionStances = _stateApp?.PendingStances.TryGetValue(battle.ZoneName, out var savedStances) == true
            ? new Dictionary<string, BattleStance>(savedStances)
            : battle.Factions.ToDictionary(faction => faction, _ => BattleStance.Defend);

        foreach (var faction in battle.Factions)
        {
            _majorPoints[faction] = 0;
            _minorPoints[faction] = 0;
        }

        _showBattlePanel = true;
        _showStanceModal = false;
    }

    private void OpenBattleForStance(ActiveBattleAppDto battle)
    {
        OpenBattle(battle);
        _showBattlePanel = false;
        _showStanceModal = true;
    }

    private async Task ConfigureAmphibiousBattle()
    {
        _actionErrorMessage = string.Empty;
        if (_activeBattleApp == null)
        {
            _actionErrorMessage = "Open a battle before saving its configuration.";
            return;
        }

        if (_activeBattleApp.IsAmphibious &&
            (string.IsNullOrWhiteSpace(_activeBattleApp.AttackerFaction) ||
             string.IsNullOrWhiteSpace(_activeBattleApp.DefenderFaction) ||
             string.Equals(_activeBattleApp.AttackerFaction, _activeBattleApp.DefenderFaction, StringComparison.OrdinalIgnoreCase)))
        {
            _actionErrorMessage = "Choose two different factions: attacker and defender.";
            return;
        }

        var response = await Http.PostAsJsonAsync($"api/Campaign/{Id}/battle/configure", new ConfigureBattleAppDto
        {
            BattleId = _activeBattleApp.Id,
            IsAmphibious = _activeBattleApp.IsAmphibious,
            AttackerFaction = _activeBattleApp.AttackerFaction,
            DefenderFaction = _activeBattleApp.DefenderFaction
        });
        if (response.IsSuccessStatusCode)
        {
            await RefreshGameStateAsync();
            return;
        }

        _actionErrorMessage = await ReadErrorMessageAsync(response, "The battle configuration could not be saved.");
    }

    private void SetStance(string faction, BattleStance stance)
    {
        _factionStances[faction] = stance;
    }

    private async Task SubmitMyStance()
    {
        _actionErrorMessage = string.Empty;
        if (_activeBattleApp == null || string.IsNullOrWhiteSpace(_battleZoneName))
        {
            _actionErrorMessage = "This battle is no longer available. Reopen it from the combat list.";
            return;
        }

        var myFaction = _gameDataApp.MyFactionName;
        var myStance = _factionStances.ContainsKey(myFaction) ? _factionStances[myFaction] : BattleStance.Defend;

        var factionsInvolved = _battleUnits.Select(u => u.FactionName).Distinct().ToList();

        var dto = new SubmitStanceAppDto
        {
            ZoneName = _battleZoneName,
            Stance = myStance,
            FactionsInvolved = factionsInvolved
        };

        var response = await Http.PostAsJsonAsync($"api/Campaign/{Id}/stance", dto);
        if (response.IsSuccessStatusCode)
        {
            // A stance is final immediately. Closing this dialog prevents each client from
            // waiting on a stale local copy of the other faction's choice.
            _showStanceModal = false;
            _showBattlePanel = true;
            await RefreshGameStateAsync();
            return;
        }

        _actionErrorMessage = await ReadErrorMessageAsync(response, "Your stance could not be submitted.");
    }

    private void CancelBattle()
    {
        _showBattlePanel = false;
        _actionErrorMessage = string.Empty;
    }

    private async Task ConfirmBattleResults()
    {
        _actionErrorMessage = string.Empty;
        if (_stateApp == null || _battleZone == null || _activeBattleApp == null)
        {
            _actionErrorMessage = "This battle is no longer available. Reopen it from the combat list.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_scenarioName))
        {
            _actionErrorMessage = "Enter the scenario name before confirming the battle.";
            return;
        }

        var updatedFiles = new Dictionary<string, string>();
        foreach (var u in _battleUnits)
        {
            if (!string.IsNullOrWhiteSpace(u.ExcelDatabase64)) updatedFiles[u.Id] = u.ExcelDatabase64;
        }

        var dto = new BattleResultAppDto
        {
            BattleId = _activeBattleApp.Id,
            ZoneName = _battleZoneName,
            TurnNumber = _stateApp.TurnNumber,
            Stances = _factionStances,
            MajorPoints = _majorPoints,
            MinorPoints = _minorPoints,
            UpdatedUnitFiles = updatedFiles,
            ScenarioName = _scenarioName,
            IsAmphibious = _activeBattleApp.IsAmphibious,
            AttackerFaction = _activeBattleApp.AttackerFaction,
            DefenderFaction = _activeBattleApp.DefenderFaction
        };

        var response = await Http.PostAsJsonAsync($"api/Campaign/{Id}/battle", dto);
        if (!response.IsSuccessStatusCode)
        {
            _actionErrorMessage = await ReadErrorMessageAsync(response, "The battle could not be confirmed.");
            return;
        }

        _showBattlePanel = false;
        _activeBattleApp = null;
        await RefreshGameStateAsync();
    }

    private async Task ColorBattle(ActiveBattleAppDto battle, bool skip)
    {
        var response = await Http.PostAsJsonAsync($"api/Campaign/{Id}/battle/color", new BattleColoringAppDto
        {
            BattleId = battle.Id,
            Skip = skip,
            FactionName = _coloringFactionName
        });

        if (response.IsSuccessStatusCode)
        {
            await RefreshGameStateAsync();
            return;
        }

        _actionErrorMessage = await ReadErrorMessageAsync(response, "The sector coloring could not be saved.");
    }

    private async Task<string> ReadErrorMessageAsync(HttpResponseMessage response, string fallback)
    {
        var serverMessage = await response.Content.ReadAsStringAsync();
        return string.IsNullOrWhiteSpace(serverMessage) ? fallback : serverMessage.Trim('"');
    }

    private void ZoomGameMapIn() => _gameMapZoom = Math.Min(200, _gameMapZoom + 25);
    private void ZoomGameMapOut() => _gameMapZoom = Math.Max(50, _gameMapZoom - 25);
    private void ResetGameMapZoom() => _gameMapZoom = 100;

    public class MapDimensions
    {
        public double Width { get; set; }
        public double Height { get; set; }
    }

    private async Task OpenExcelEditor(UnitAppDto unitApp)
    {
        _actionErrorMessage = string.Empty;
        _editingUnitApp = unitApp;
        _activeExcelGrid = new List<List<string>>();

        if (!string.IsNullOrWhiteSpace(unitApp.ExcelDatabase64))
        {
            try
            {
                _originalExcelBytes = Convert.FromBase64String(unitApp.ExcelDatabase64);
                using var stream = new MemoryStream(_originalExcelBytes);
                using var workbook = new XLWorkbook(stream);
                var worksheet = workbook.Worksheets.First();
                var rowsTotal = worksheet.LastRowUsed().RowNumber();
                var colsTotal = worksheet.LastColumnUsed().ColumnNumber();

                for (var r = 1; r <= rowsTotal; r++)
                {
                    var rowList = new List<string>();
                    for (var c = 1; c <= colsTotal; c++)
                    {
                        rowList.Add(worksheet.Cell(r, c).GetValue<string>());
                    }

                    _activeExcelGrid.Add(rowList);
                }
            }
            catch (Exception e)
            {
                Console.WriteLine($"Erro reading excel file: {e.Message}");
                GenerateBlankTemplate();
            }
        }
        else
        {
            GenerateBlankTemplate();
        }
    }

    private void GenerateBlankTemplate()
    {
        _originalExcelBytes = null;
        _activeExcelGrid = new List<List<string>> { new() { string.Empty } };
    }

    private void AddExcelRow()
    {
        if (_activeExcelGrid == null) return;
        var colCount = _activeExcelGrid.FirstOrDefault()?.Count ?? 1;
        _activeExcelGrid.Add(Enumerable.Repeat(string.Empty, Math.Max(1, colCount)).ToList());
    }

    private void AddExcelColumn()
    {
        if (_activeExcelGrid == null) return;
        if (!_activeExcelGrid.Any())
        {
            _activeExcelGrid.Add(new List<string> { string.Empty });
            return;
        }

        foreach (var row in _activeExcelGrid) row.Add(string.Empty);
    }

    private async Task SaveExcelData()
    {
        if (_editingUnitApp != null && _activeExcelGrid != null)
        {
            XLWorkbook workbook;
            if (_originalExcelBytes != null)
            {
                var stream = new MemoryStream(_originalExcelBytes);
                workbook = new XLWorkbook(stream);
            }
            else
            {
                workbook = new XLWorkbook();
                workbook.Worksheets.Add("Unit Intel");
            }

            var worksheet = workbook.Worksheet(1);
            for (var r = 0; r < _activeExcelGrid.Count; r++)
            {
                for (var c = 0; c < _activeExcelGrid[r].Count; c++)
                {
                    worksheet.Cell(r + 1, c + 1).Value = _activeExcelGrid[r][c] ?? "";
                }
            }

            using var outStream = new MemoryStream();
            workbook.SaveAs(outStream);
            _editingUnitApp.ExcelDatabase64 = Convert.ToBase64String(outStream.ToArray());

            if (_showRosterModal)
            {
                var response = await Http.PostAsJsonAsync($"api/Campaign/{Id}/unit/{_editingUnitApp.Id}/excel", new UpdateUnitExcelAppDto
                {
                    ExcelFileName = _editingUnitApp.ExcelFileName,
                    ExcelDatabase64 = _editingUnitApp.ExcelDatabase64
                });
                if (!response.IsSuccessStatusCode)
                {
                    _actionErrorMessage = await ReadErrorMessageAsync(response, "The unit spreadsheet could not be saved.");
                    return;
                }
            }

            CloseExcelEditor();
        }
    }

    private void CloseExcelEditor()
    {
        _editingUnitApp = null;
        _activeExcelGrid = null;
        _originalExcelBytes = null;
    }

    private void CloseRosterModal()
    {
        _showRosterModal = false;
        CloseExcelEditor();
    }

    public class UnitZoneMapping
    {
        public string UnitId { get; set; }
        public int ZoneId { get; set; }
    }

    private async Task RefreshGameStateAsync()
    {
        await _stateRefreshLock.WaitAsync();
        try
        {
            await LoadGameDataAsync();
            await PaintZoneOwnershipAsync();
            await RecalculateBattleAvailability();
            StateHasChanged();
        }
        finally
        {
            _stateRefreshLock.Release();
        }
    }

    private async Task PaintZoneOwnershipAsync()
    {
        if (!_mapRendered || _stateApp?.Zones == null) return;

        await JS.InvokeVoidAsync("mapTools.resetMap");

        foreach (var zone in _stateApp.Zones)
        {
            var factionColor = GetFactionColor(zone.FactionName);
            if (!string.IsNullOrEmpty(factionColor))
                await JS.InvokeVoidAsync("mapTools.floodFillRaw", zone.X, zone.Y, factionColor);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            if (_hubConnection.State == HubConnectionState.Connected)
                await _hubConnection.SendAsync("LeaveCampaignGroup", Id);
            await _hubConnection.DisposeAsync();
        }
    }
}
